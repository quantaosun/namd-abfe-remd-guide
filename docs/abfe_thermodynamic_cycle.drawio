    <!-- FINAL EQUATION BOX                                      -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <mxCell id="eqBox" value="&lt;b&gt;Final Equation:&lt;/b&gt;&lt;br&gt;ΔG_bind = ΔG_site − ΔG_solv + ΔG_restr_on + ΔG_restr_analytical&lt;br&gt;&lt;br&gt;where:  ΔG_site = ΔG_site_elec + ΔG_site_vdw  |  ΔG_solv = ΔG_solv_elec + ΔG_solv_vdw&lt;br&gt;ΔG_restr_on = numerical (from simulation)  |  ΔG_restr_analytical = Boresch correction (analytical, from force constants)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#555555;fontColor=#1A252F;fontSize=12;fontStyle=0;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
